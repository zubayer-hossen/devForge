NODE_ENV=development
PORT=5001
TZ=Asia/Dhaka

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/devforge

# App URLs
CLIENT_URL=http://localhost:5173
APP_URL=http://localhost:5001
TRUST_PROXY_HOPS=1

# Generate three different random secrets (minimum 32 characters each)
JWT_ACCESS_SECRET=replace_with_a_random_secret_at_least_32_characters
JWT_REFRESH_SECRET=replace_with_a_different_random_secret_at_least_32_characters
COOKIE_SECRET=replace_with_another_random_secret_at_least_32_characters

# Email provider: brevo or resend
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=DevForge
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional services
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
TURNSTILE_SECRET_KEY=

# Optional first-time Super Admin bootstrap (remove ADMIN_PASSWORD after use)
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
